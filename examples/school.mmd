classDiagram
    class School {
        +String name
        +registerStudent(student)
    }

    class Student {
        +String studentId
        +String name
    }

    class Enrollment {
        +Date enrolledAt
        +String status
    }

    <<AssociationClass>> Enrollment
    School "1" --> "*" Enrollment : registrations
    Student "1" --> "*" Enrollment : enrollments
    note for Enrollment "Connects a student to a school"

