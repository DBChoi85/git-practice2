classDiagram
    class Entity {
        +String id
    }
    class Person {
        +String name
    }
    class Student {
        +String studentNumber
        +enroll()
    }
    class Teacher {
        +String employeeNumber
        +teach()
    }
    class TeachingAssistant {
        +assist()
    }

    Entity <|-- Person
    Person <|-- Student
    Person <|-- Teacher
    Student <|-- TeachingAssistant
    Teacher <|-- TeachingAssistant
